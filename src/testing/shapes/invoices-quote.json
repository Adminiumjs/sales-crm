{
  "addOn": "invoices",
  "version": "1.0.7",
  "shapes": [
    {
      "name": "quote",
      "version": 1,
      "parts": {
        "document": {
          "columns": [
            {
              "ref": "id",
              "type": "int",
              "role": "pk"
            },
            {
              "ref": "number_seq",
              "type": "int",
              "nullable": true,
              "rules": {
                "sequence": {
                  "gapless": true,
                  "startSetting": {
                    "addOn": "invoices",
                    "setting": "number_start_quote"
                  }
                }
              }
            },
            {
              "ref": "number",
              "type": "text",
              "maxLength": 24,
              "nullable": true,
              "unique": true,
              "rules": {
                "format": {
                  "from": "number_seq",
                  "prefixSetting": {
                    "addOn": "invoices",
                    "setting": "prefix_quote"
                  },
                  "pad": 4
                }
              }
            },
            {
              "ref": "status",
              "type": "enum",
              "enum": [
                "draft",
                "sent",
                "accepted",
                "declined",
                "withdrawn"
              ],
              "default": "draft"
            },
            {
              "ref": "valid_until",
              "type": "date",
              "nullable": true
            },
            {
              "ref": "currency",
              "type": "text",
              "maxLength": 3,
              "nullable": true,
              "rules": {
                "default": {
                  "from": "connection.currency"
                }
              }
            },
            {
              "ref": "tax_name",
              "type": "text",
              "maxLength": 40,
              "nullable": true,
              "rules": {
                "default": {
                  "from": {
                    "addOn": "invoices",
                    "setting": "tax_name"
                  }
                }
              }
            },
            {
              "ref": "tax_rate",
              "type": "decimal",
              "scale": 3,
              "nullable": true,
              "rules": {
                "default": {
                  "from": {
                    "addOn": "invoices",
                    "setting": "default_tax_rate"
                  }
                }
              }
            },
            {
              "ref": "subtotal",
              "type": "decimal",
              "scale": "currency",
              "nullable": true,
              "rules": {
                "rollup": {
                  "from": "lines",
                  "via": "document_id",
                  "sum": "amount"
                }
              }
            },
            {
              "ref": "tax",
              "type": "decimal",
              "scale": "currency",
              "nullable": true,
              "rules": {
                "formula": {
                  "round": {
                    "div": [
                      {
                        "mul": [
                          "subtotal",
                          {
                            "coalesce": [
                              "tax_rate",
                              0
                            ]
                          }
                        ]
                      },
                      100
                    ]
                  }
                }
              }
            },
            {
              "ref": "total",
              "type": "decimal",
              "scale": "currency",
              "nullable": true,
              "rules": {
                "formula": {
                  "add": [
                    {
                      "coalesce": [
                        "subtotal",
                        0
                      ]
                    },
                    {
                      "coalesce": [
                        "tax",
                        0
                      ]
                    }
                  ]
                }
              }
            },
            {
              "ref": "sent_at",
              "type": "timestamptz",
              "nullable": true,
              "rules": {
                "stamp": {
                  "set": "now",
                  "on": {
                    "column": "status",
                    "values": [
                      "sent"
                    ]
                  }
                }
              }
            },
            {
              "ref": "decided_at",
              "type": "timestamptz",
              "nullable": true,
              "rules": {
                "stamp": {
                  "set": "now",
                  "on": {
                    "column": "status",
                    "values": [
                      "accepted",
                      "declined",
                      "withdrawn"
                    ]
                  }
                }
              }
            },
            {
              "ref": "withdraw_reason",
              "type": "text",
              "maxLength": 500,
              "nullable": true
            }
          ],
          "states": {
            "column": "status",
            "initial": "draft",
            "moves": {
              "draft": [
                {
                  "to": "sent",
                  "requires": {
                    "children": {
                      "lines": 1
                    },
                    "where": [
                      {
                        "column": "total",
                        "gt": 0
                      }
                    ]
                  }
                }
              ],
              "sent": [
                "accepted",
                "declined",
                "withdrawn"
              ]
            },
            "lock": {
              "when": [
                "sent",
                "accepted",
                "declined",
                "withdrawn"
              ],
              "except": [
                "valid_until",
                "decided_at",
                "withdraw_reason"
              ]
            },
            "children": {
              "lines": {
                "via": "document_id",
                "lock": true
              }
            },
            "onlyLater": [
              "valid_until"
            ]
          }
        },
        "lines": {
          "columns": [
            {
              "ref": "id",
              "type": "int",
              "role": "pk"
            },
            {
              "ref": "document_id",
              "type": "fk",
              "references": "document"
            },
            {
              "ref": "position",
              "type": "int",
              "default": 0
            },
            {
              "ref": "description",
              "type": "text",
              "maxLength": 500,
              "nullable": true
            },
            {
              "ref": "qty",
              "type": "decimal",
              "scale": 3,
              "default": 1
            },
            {
              "ref": "rate",
              "type": "decimal",
              "scale": "currency",
              "nullable": true
            },
            {
              "ref": "discount_kind",
              "type": "enum",
              "enum": [
                "amount",
                "percent"
              ],
              "default": "amount"
            },
            {
              "ref": "discount",
              "type": "decimal",
              "scale": 3,
              "nullable": true
            },
            {
              "ref": "currency",
              "type": "text",
              "maxLength": 3,
              "nullable": true,
              "rules": {
                "copy": {
                  "via": "document_id",
                  "from": "currency",
                  "mode": "always"
                }
              }
            },
            {
              "ref": "amount",
              "type": "decimal",
              "scale": "currency",
              "nullable": true,
              "rules": {
                "formula": {
                  "max": [
                    0,
                    {
                      "if": [
                        {
                          "eq": [
                            "discount_kind",
                            "percent"
                          ]
                        },
                        {
                          "mul": [
                            "qty",
                            "rate",
                            {
                              "sub": [
                                1,
                                {
                                  "div": [
                                    {
                                      "coalesce": [
                                        "discount",
                                        0
                                      ]
                                    },
                                    100
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "sub": [
                            {
                              "mul": [
                                "qty",
                                "rate"
                              ]
                            },
                            {
                              "coalesce": [
                                "discount",
                                0
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "documentProfiles": [
        {
          "kind": "quote",
          "part": "document",
          "name": {
            "en-US": "Quote",
            "de-DE": "Angebot",
            "fr-FR": "Devis",
            "cs-CZ": "Nabídka",
            "da-DK": "Tilbud",
            "zh-CN": "报价单",
            "zh-TW": "報價單",
            "ar-EG": "عرض سعر"
          },
          "mapping": {
            "number": {
              "column": "number"
            },
            "sentOn": {
              "column": "sent_at"
            },
            "validUntil": {
              "column": "valid_until"
            },
            "currency": {
              "column": "currency"
            },
            "taxName": {
              "column": "tax_name"
            },
            "taxRate": {
              "column": "tax_rate"
            },
            "subtotal": {
              "column": "subtotal"
            },
            "tax": {
              "column": "tax"
            },
            "total": {
              "column": "total"
            },
            "status": {
              "column": "status"
            },
            "items": {
              "collection": {
                "table": "lines",
                "via": "document_id",
                "orderBy": "position",
                "columns": {
                  "desc": "description",
                  "qty": "qty",
                  "rate": "rate",
                  "discount": "discount",
                  "discountKind": "discount_kind",
                  "amount": "amount"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
