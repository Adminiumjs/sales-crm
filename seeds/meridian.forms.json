     "definition": {
      "v": 1,
      "kind": "form",
      "languages": [
       "en-US",
       "de-DE"
      ],
      "defaultLanguage": "en-US",
      "title": {
       "en-US": "Book a showroom visit",
       "de-DE": "Ausstellungsbesuch buchen"
      },
      "intro": {
       "en-US": "Come and sit in the chairs, try the booths and bring your drawings. Tell us when, and we will have it ready.",
       "de-DE": "Probieren Sie Stühle und Kabinen aus und bringen Sie Ihren Grundriss mit. Sagen Sie uns, wann, und wir bereiten alles vor."
      },
      "questions": [
       {
        "id": "qname",
        "kind": "short",
        "role": "name",
        "required": true,
        "label": {
         "en-US": "Your name",
         "de-DE": "Ihr Name"
        }
       },
       {
        "id": "qemail",
        "kind": "short",
        "check": "email",
        "role": "email",
        "required": true,
        "label": {
         "en-US": "Work e-mail",
         "de-DE": "Geschäftliche E-Mail"
        }
       },
       {
        "id": "qcompany",
        "kind": "short",
        "role": "company",
        "required": true,
        "label": {
         "en-US": "Company",
         "de-DE": "Firma"
        }
       },
       {
        "id": "qday",
        "kind": "date",
        "from": "tomorrow",
        "label": {
         "en-US": "Which day suits you?",
         "de-DE": "Welcher Tag passt Ihnen?"
        }
       },
       {
        "id": "qsee",
        "kind": "several",
        "label": {
         "en-US": "What would you like to see?",
         "de-DE": "Was möchten Sie sehen?"
        },
        "choices": [
         {
          "id": "booths",
          "label": {
           "en-US": "Acoustic booths",
           "de-DE": "Akustikkabinen"
          }
         },
         {
          "id": "desks",
          "label": {
           "en-US": "Sit-stand desks",
           "de-DE": "Sitz-Steh-Tische"
          }
         },
         {
          "id": "seating",
          "label": {
           "en-US": "Task seating",
           "de-DE": "Bürostühle"
          }
         },
         {
          "id": "tables",
          "label": {
           "en-US": "Meeting tables",
           "de-DE": "Besprechungstische"
          }
         },
         {
          "id": "storage",
          "label": {
           "en-US": "Storage and lockers",
           "de-DE": "Stauraum und Schließfächer"
          }
         }
        ]
       },
       {
        "id": "qbrochure",
        "kind": "one",
        "label": {
         "en-US": "Send me the brochure",
         "de-DE": "Schicken Sie mir die Broschüre"
        },
        "choices": [
         {
          "id": "yes",
          "label": {
           "en-US": "Yes, please",
           "de-DE": "Ja, bitte"
          }
         },
         {
          "id": "no",
          "label": {
           "en-US": "No, thank you",
           "de-DE": "Nein, danke"
          }
         }
        ]
       },
       {
        "id": "qdrawings",
        "kind": "file",
        "maxMb": 10,
        "kinds": [
         "pdf",
         "jpg",
         "png"
        ],
        "many": true,
        "label": {
         "en-US": "Floor plans or drawings",
         "de-DE": "Grundrisse oder Zeichnungen"
        }
       },
       {
        "id": "qnote",
        "kind": "long",
        "label": {
         "en-US": "Anything else we should know?",
         "de-DE": "Sollen wir noch etwas wissen?"
        }
       },
       {
        "id": "qnews",
        "kind": "tick",
        "purpose": "newsletter",
        "label": {
         "en-US": "Send me Meridian's newsletter, about once a month. I can say no at any time.",
         "de-DE": "Schicken Sie mir den Newsletter von Meridian, etwa einmal im Monat. Ich kann jederzeit Nein sagen."
        },
        "wordingVersion": 1,
        "wordingChangedAt": "2026-09-01",
        "confirm": true
       }
      ],
      "ending": {
       "kind": "words",
       "words": {
        "en-US": "Thank you. We will be in touch within a working day.",
        "de-DE": "Vielen Dank. Wir melden uns innerhalb eines Werktags."
       }
      }
     },
