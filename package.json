{
  "name": "sales-crm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sales CRM \u2014 an open-source sales-workspace example app for Adminium.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run --dir src",
    "build:surface:staff": "VITE_ADMINIUM_SURFACE_SIDE=staff tsc -b && VITE_ADMINIUM_SURFACE_SIDE=staff vite build --base=/apps/crm/staff/ --outDir dist-surface/crm/staff",
    "build:surface": "npm run build:surface:staff",
    "dev:hosted": "VITE_ADMINIUM_SURFACE_SIDE=staff vite",
    "e2e": "npm run build:surface && playwright test",
    "stand:up": "npm run build:surface && node e2e/stand.mjs up",
    "stand:down": "node e2e/stand.mjs down",
    "proofs": "node scripts/run-proofs.mjs"
  },
  "dependencies": {
    "@adminiumjs/public-client": "^0.2.2",
    "lucide-react": "^0.462.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vitest": "^2.1.9",
    "zod": "^4.4.3"
  }
}
