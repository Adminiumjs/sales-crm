{
  "manifestVersion": 1,
  "key": "crm",
  "name": "Sales CRM",
  "version": "1.0.0",
  "publisher": {
    "id": "adminium",
    "name": "Adminium",
    "url": "https://adminium.dev"
  },
  "license": "AGPL-3.0-only",
  "description": {
    "key": "mft.crm.desc",
    "fallback": "A working sales day — a weighted pipeline board, a follow-up queue and deal rooms with a full activity history — backed by your own database."
  },
  "categories": [
    "crm"
  ],
  "compatibility": {
    "minAdminiumVersion": "1.0.0",
    "engines": [
      "postgres",
      "mysql",
      "sqlite"
    ],
    "requires": [
      "realtime"
    ]
  },
  "requiredSchema": {
    "tables": [
      {
        "ref": "users",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "name",
            "type": "text"
          },
          {
            "ref": "email",
            "type": "text",
            "semantic": "email"
          },
          {
            "ref": "initials",
            "type": "text"
          },
          {
            "ref": "avatar",
            "type": "text",
            "semantic": "image"
          },
          {
            "ref": "tint",
            "type": "text"
          },
          {
            "ref": "role",
            "type": "enum",
            "enum": [
              "rep",
              "manager"
            ]
          },
          {
            "ref": "created_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "companies",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "name",
            "type": "text"
          },
          {
            "ref": "domain",
            "type": "text"
          },
          {
            "ref": "industry",
            "type": "enum",
            "enum": [
              "law",
              "health",
              "data",
              "freight",
              "film",
              "grocery",
              "accountancy",
              "robotics",
              "aerospace"
            ]
          },
          {
            "ref": "city",
            "type": "text"
          },
          {
            "ref": "headcount",
            "type": "int"
          },
          {
            "ref": "initials",
            "type": "text"
          },
          {
            "ref": "tint",
            "type": "text"
          },
          {
            "ref": "icon",
            "type": "text"
          },
          {
            "ref": "since_note",
            "type": "text"
          },
          {
            "ref": "note",
            "type": "text"
          },
          {
            "ref": "created_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "contacts",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "company_id",
            "type": "fk",
            "references": "companies"
          },
          {
            "ref": "name",
            "type": "text"
          },
          {
            "ref": "email",
            "type": "text",
            "semantic": "email"
          },
          {
            "ref": "phone",
            "type": "text"
          },
          {
            "ref": "title",
            "type": "text"
          },
          {
            "ref": "initials",
            "type": "text"
          },
          {
            "ref": "created_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "pipelines",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "name",
            "type": "text"
          }
        ]
      },
      {
        "ref": "stages",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "pipeline_id",
            "type": "fk",
            "references": "pipelines"
          },
          {
            "ref": "name",
            "type": "text"
          },
          {
            "ref": "position",
            "type": "int"
          },
          {
            "ref": "probability",
            "type": "int"
          }
        ]
      },
      {
        "ref": "deals",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "name",
            "type": "text"
          },
          {
            "ref": "company_id",
            "type": "fk",
            "references": "companies"
          },
          {
            "ref": "contact_id",
            "type": "fk",
            "references": "contacts"
          },
          {
            "ref": "stage_id",
            "type": "fk",
            "references": "stages"
          },
          {
            "ref": "amount",
            "type": "money"
          },
          {
            "ref": "currency",
            "type": "text"
          },
          {
            "ref": "expected_close",
            "type": "date"
          },
          {
            "ref": "status",
            "type": "enum",
            "enum": [
              "open",
              "won",
              "lost"
            ]
          },
          {
            "ref": "lost_reason",
            "type": "text"
          },
          {
            "ref": "owner_id",
            "type": "fk",
            "references": "users"
          },
          {
            "ref": "scope",
            "type": "text"
          },
          {
            "ref": "stage_entered_at",
            "type": "timestamptz"
          },
          {
            "ref": "closed_on",
            "type": "date"
          },
          {
            "ref": "created_at",
            "type": "timestamptz"
          },
          {
            "ref": "updated_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "activities",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "deal_id",
            "type": "fk",
            "references": "deals"
          },
          {
            "ref": "type",
            "type": "enum",
            "enum": [
              "call",
              "email",
              "meeting",
              "note",
              "stage_change"
            ]
          },
          {
            "ref": "summary",
            "type": "text"
          },
          {
            "ref": "due_at",
            "type": "timestamptz"
          },
          {
            "ref": "done",
            "type": "bool"
          },
          {
            "ref": "created_by",
            "type": "fk",
            "references": "users"
          },
          {
            "ref": "created_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "tasks",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "deal_id",
            "type": "fk",
            "references": "deals"
          },
          {
            "ref": "title",
            "type": "text"
          },
          {
            "ref": "due_at",
            "type": "timestamptz"
          },
          {
            "ref": "done",
            "type": "bool"
          },
          {
            "ref": "owner_id",
            "type": "fk",
            "references": "users"
          }
        ]
      }
    ]
  },
  "pages": [
    {
      "ref": "crm-dashboard",
      "template": "page-dashboard",
      "title": {
        "key": "mft.crm.page.dashboard",
        "fallback": "Dashboard"
      },
      "nav": {
        "group": "manifest:crm",
        "icon": "layout-dashboard",
        "order": 1
      }
    },
    {
      "ref": "crm-board",
      "template": "page-board",
      "title": {
        "key": "mft.crm.page.board",
        "fallback": "Pipeline"
      },
      "nav": {
        "group": "manifest:crm",
        "icon": "columns-3",
        "order": 2
      }
    },
    {
      "ref": "crm-companies",
      "template": "page-master-detail",
      "title": {
        "key": "mft.crm.page.companies",
        "fallback": "Companies"
      },
      "nav": {
        "group": "manifest:crm",
        "icon": "building-2",
        "order": 3
      }
    },
    {
      "ref": "crm-contacts",
      "template": "page-crud",
      "title": {
        "key": "mft.crm.page.contacts",
        "fallback": "People"
      },
      "nav": {
        "group": "manifest:crm",
        "icon": "contact",
        "order": 4
      }
    },
    {
      "ref": "crm-tasks",
      "template": "page-queue-inbox",
      "title": {
        "key": "mft.crm.page.tasks",
        "fallback": "Follow-ups"
      },
      "nav": {
        "group": "manifest:crm",
        "icon": "list-checks",
        "order": 5
      }
    }
  ],
  "capabilities": [
    "email-delivery",
    "realtime",
    "file-storage"
  ],
  "kind": "app",
  "frontends": [
    {
      "side": "staff",
      "kind": "spa",
      "entry": "index.html",
      "env": {
        "VITE_ADMINIUM_API_BASE_URL": {
          "required": false,
          "example": "https://admin.example.com"
        },
        "VITE_ADMINIUM_PUBLISHABLE_KEY": {
          "required": false,
          "example": "adm_pub_..."
        }
      },
      "routes": {
        "today": "/",
        "board": "/",
        "manager": "/"
      }
    }
  ]
}
